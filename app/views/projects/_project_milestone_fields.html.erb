<div class="nested-fields">
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </div>
  <div>
    <%= f.label :reach %><br>
    <%= f.number_field :reach %>
  </div>
  <div>
    <%= f.label :conversion %><br>
    <%= f.number_field :conversion %>
  </div>
  <div>
    <%= f.label :budget %><br>
    <%= f.number_field :budget %>
  </div>
  <%= link_to_remove_association "Delete", f, class:"btn btn-danger mb-2" %>
</div>
