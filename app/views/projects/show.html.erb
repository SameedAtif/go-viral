<div>
  <h1><%= @project.title %></h1>
  <h4><%= @project.description %></h4>
  <h4><%= @project.budget %></h4>
  <% if session[:user_role] == "Client" && @project.client == current_user.client %>
    <%= link_to "Edit Project", edit_project_path(@project.id) %>
    <%= link_to "View Applications", edit_project_path(@project.id) %>
  <% end %>
</div>
<div>
  <% if session[:user_role] == "Influencer" %>
    <%= button_to(
      "Apply for campaign",
      new_project_project_application_path(@project.id),
      method: :get
    ) %>
  <% end %>
</div>
