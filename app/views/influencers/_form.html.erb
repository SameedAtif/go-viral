<%= javascript_include_tag "views/gigs/form.js" %>

<div class="flex flex-row p-4">
    <ul class="flex-column space-y space-y-4 text-sm font-medium md:me-4 mb-4 md:mb-0 min-w-80" id="default-tab" data-tabs-toggle="#default-tab-content" role="tablist">
        <li role="presentation">
            <button
                id="basic-tab"
                data-tabs-target="#basic"
                type="button"
                role="tab"
                aria-controls="basic"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Basic Information
            </button>
        </li>
        <li role="presentation">
            <button
                id="platform-tab"
                data-tabs-target="#platform"
                type="button"
                role="tab"
                aria-controls="platform"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Influencer Portfolio
            </button>
        </li>
        <li role="presentation">
            <button
                id="portfolio-tab"
                data-tabs-target="#portfolio"
                type="button"
                role="tab"
                aria-controls="portfolio"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Influencer Portfolio
            </button>
        </li>
    </ul>
    <div class="p-6 text-medium rounded-lg w-full">
        <%= form_with model: @influencer, local: true do |f| %>
            <div id="basic" role="tabpanel" aria-labelledby="basic-tab" class="tab-content">
                <div class="p-4 md:p-5 space-y-4">
                  <div class="mb-5">
                    <%= f.label 'Tell the world about yourself', class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
                    <%= f.rich_text_area :bio, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "Awesome Gig", required: true %>
                  </div>
                </div>
            </div>
            <div id="platform" role="tabpanel" aria-labelledby="platform-tab" class="tab-content">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Portfolio Tab</h3>
                <div class="influencer_platforms">
                  <%= f.fields_for :influencer_platforms do |platform| %>
                    <%= render 'influencers/form/influencer_platform_fields', f: platform %>
                  <% end %>
                  <%= link_to_add_association "Add Platform", f, :influencer_platforms, partial: 'influencers/form/influencer_platform_fields', data: {association_insertion_node: '.influencer_platforms', association_insertion_method: :append} %>
                </div>
            </div>
            <div id="portfolio" role="tabpanel" aria-labelledby="portfolio-tab" class="tab-content">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Portfolio Tab</h3>
                <div class="influencer_portfolios">
                  <%= f.fields_for :influencer_portfolios do |portfolio| %>
                    <%= render 'influencers/form/influencer_portfolio_fields', f: portfolio %>
                  <% end %>
                  <%= link_to_add_association "Add Portfolio", f, :influencer_portfolios, partial: 'influencers/form/influencer_portfolio_fields', data: {association_insertion_node: '.influencer_portfolios', association_insertion_method: :append} %>
                </div>
            </div>
            <%= f.submit "Continue", onclick: "validateForm()" %>
        <% end %>
    </div>
</div>
