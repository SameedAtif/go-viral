<div class="mt-2 px-6 py-4 bg-white rounded-lg shadow w-full">
      <div class=" inline-flex items-center justify-between w-full">
        <div class="inline-flex items-center">
          <%= render partial: notification_icon(notification.notification_type) %>
          <h3 class="font-bold text-base text-gray-800"><%= notification.extra["title"] %></h3>
        </div>
        <p class="text-xs text-gray-500">
          <%= notification.created_at.strftime("at %I:%M %p")%>
        </p>
      </div>
      <p class="mt-1 text-sm">
        <%= notification.extra["description"] %>
      </p>
    </div>
