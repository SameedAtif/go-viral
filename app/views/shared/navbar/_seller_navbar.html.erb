<nav class="bg-white border-b border- ">
  <div class="max-w-screen-2xl flex flex-wrap items-center md:justify-between mx-auto py-2 px-4">
    <%= link_to root_path, class: "order-2 lg:order-1 flex items-center py-4 mx-auto md:mx-0" do %>
      <span class="self-center text-2xl font-semibold whitespace-nowrap">TheCreatorBazaar</span>
      <% end %>

        <div class="order-3 lg:order-2 flex flex-1 items-center px-2 mx-auto sm:ml-6 justify-end lg:justify-start">
          <div class="w-full md:w-96 min-w-max max-w-lg lg:max-w-md">
            <ul
              class="flex flex-row font-medium p-4 md:p-0 sm:border sm:border-gray-100 rounded-lg md:flex-row md:space-x-8 md:mt-0 md:border-0">
              <% seller_navbar_items.map do |navbar_item| %>
                <%= render partial: "shared/elements/navbar_li_content" , locals: { content: navbar_item[:content],
                  path: navbar_item[:path] } %>
              <% end %>
            </ul>
          </div>
        </div>

        <button data-collapse-toggle="navbar-dropdown" type="button"
          class="order-1 inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200"
          aria-expanded="false" aria-haspopup="true">
          <span class="sr-only">Open main menu</span>
          <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M1 1h15M1 7h15M1 13h15" />
          </svg>
        </button>
        <div class="order-3 hidden w-full lg:block md:w-auto" id="navbar-dropdown">
          <ul
            class="flex flex-col font-medium p-4 md:p-0 mt-4 sm:border sm:border-gray-100 rounded-lg md:flex-row md:space-x-8 md:mt-0 md:border-0">
            <li class="py-2.5">
              <button type="button"
                class="relative rounded-full bg-white p-1 text-gray-400 hover:text-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                <span class="absolute -inset-1.5"></span>
                <span class="sr-only">View notifications</span>
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                  aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                </svg>
              </button>
            </li>

            <li class="py-2.5">
              <button id="user_profile_icon" data-dropdown-toggle="profiledropdown"
                class="flex items-center justify-between w-full py-2 pl-3 pr-4 text-neutral-600 rounded hover:bg-gray-100 md:hover:bg-transparent md:border-0 md:hover:text-blue-700 md:p-0 md:w-auto">
                <span class="sr-only">Open user menu</span>
                <img class="w-10 h-10 rounded-full" src="https://picsum.photos/200" alt="user photo">
              </button>

              <%= render partial: "shared/navbar/seller_menu" %>
            </li>
          </ul>
        </div>
  </div>
</nav>