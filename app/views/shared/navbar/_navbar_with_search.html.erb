<nav class="bg-white border-b border- ">
  <div class="max-w-screen-2xl flex flex-wrap items-center md:justify-between mx-auto py-2 px-4">
    <%= link_to root_path, class: "order-2 lg:order-1 flex items-center py-4 mx-auto md:mx-0" do %>
      <span class="self-center text-2xl font-semibold whitespace-nowrap">TheCreatorBazaar</span>
    <% end %>

    <div class="order-3 lg:order-2 flex flex-1 items-center px-2 ml-6 justify-end lg:justify-start">
      <div class="w-full md:w-96 min-w-max max-w-lg lg:max-w-md">
        <label for="search" class="sr-only">Search</label>
        <div class="relative">
          <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
            <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd"
                d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                clip-rule="evenodd" />
            </svg>
          </div>
          <input id="search" name="search"
            class="h-10 block w-full rounded-md border-0 bg-white py-1.5 pl-10 pr-3 text-gray-900 ring-1 ring-inset ring-zinc-200 placeholder:text-gray-400 focus:ring-1 focus:ring-inset focus:ring-zinc-500 sm:text-sm sm:leading-6"
            placeholder='<%= t("header.navbar.influencers_search") %>' type="search" required onkeyup="searchInfluencer()">
        </div>
        <div id="search-results" class="flex flex-col gap-2 px-3"></div>
        <!-- Empty state -->
        <div id="no-results" class="hidden px-6 py-14 text-center text-sm sm:px-14">
          <svg class="mx-auto h-6 w-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
          </svg>
          <p class="mt-4 font-semibold text-gray-900">No people found</p>
          <p class="mt-2 text-gray-500">We couldn’t find anything with that term. Please try again.</p>
        </div>
      </div>
    </div>

    <button data-collapse-toggle="navbar-dropdown" type="button"
      class="order-1 inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200"
      aria-expanded="false" aria-haspopup="true">
      <span class="sr-only">Open main menu</span>
      <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M1 1h15M1 7h15M1 13h15" />
      </svg>
    </button>
    <div class="order-3 hidden w-full lg:block md:w-auto" id="navbar-dropdown">
      <ul
        class="flex flex-col font-medium p-4 md:p-0 mt-4 sm:border sm:border-gray-100 rounded-lg md:flex-row md:space-x-8 md:mt-0 md:border-0">
        <li class="py-2.5">
          <%= render partial: "shared/navbar/#{verified_role.is_a?(Client) ? 'client_button': 'influencer_button'}" %>
        </li>

        <li class="py-2.5">
          <button id="user_profile_icon" data-dropdown-toggle="profiledropdown"
            class="flex items-center justify-between w-full py-2 pl-3 pr-4 text-neutral-600 rounded hover:bg-gray-100 md:hover:bg-transparent md:border-0 md:hover:text-blue-700 md:p-0 md:w-auto">
            <span class="sr-only">Open user menu</span>
            <img class="w-10 h-10 rounded-full" src="https://picsum.photos/200" alt="user photo">
          </button>
          <%= render partial: "shared/navbar/#{verified_role.is_a?(Client) ? 'buyer_menu': 'seller_menu'}" %>
        </li>
      </ul>
    </div>
  </div>
</nav>
<script>
function searchInfluencer() {
  var query = document.getElementById('search').value;

  fetch(`/search?query=${encodeURIComponent(query)}`)
    .then(response => response.json())
    .then(data => {
      updateSearchResults(data);
    })
    .catch(error => {
      console.error('Error fetching data: ', error);
    });
}

function updateSearchResults(results) {
  const searchResultsContainer = document.getElementById('search-results');
  const noResultsContainer = document.getElementById('no-results');

  searchResultsContainer.innerHTML = '';
  
  if (results.length === 0) {
    noResultsContainer.classList.remove('hidden');
  } else {
    noResultsContainer.classList.add('hidden');

    // Group results by type (Influencers and Platforms)
    const groupedResults = {
      influencers: [],
      platforms: []
    };

    results.forEach(result => {
      if (result.type === 'influencer') {
        groupedResults.influencers.push(result);
      } else if (result.type === 'platform') {
        groupedResults.platforms.push(result);
      }
    });

    // Add influencers section
    if (groupedResults.influencers.length > 0) {
      addResultsSection('Influencers', groupedResults.influencers);
    }

    // Add platforms section
    if (groupedResults.platforms.length > 0) {
      addResultsSection('Platforms', groupedResults.platforms);
    }
  }
}

function addResultsSection(heading, results) {
  const searchResultsContainer = document.getElementById('search-results');
  const headingElement = document.createElement('h2');
  headingElement.textContent = heading;
  headingElement.classList.add('text-lg', 'font-bold', 'mt-4', 'mb-2');
  searchResultsContainer.appendChild(headingElement);

  results.forEach(result => {
    const anchorElement = document.createElement('a');
    anchorElement.href = result.type == 'influencer' ?  `influencers/${result.id}` : `gigs?platform=${result.name}` ; 
    const resultElement = document.createElement('div');
    resultElement.className = 'flex items-center border rounded-md p-2 bg-white shadow-sm';
    const imgElement = document.createElement('img');
    imgElement.src = result.image_url;
    imgElement.alt = '';
    imgElement.className = 'h-8 w-8 rounded-full flex-none';
    const nameSpanElement = document.createElement('span');
    nameSpanElement.textContent = result.name;
    nameSpanElement.className = 'ml-3 flex-auto truncate';
    resultElement.appendChild(imgElement);
    resultElement.appendChild(nameSpanElement);
    anchorElement.appendChild(resultElement);
    searchResultsContainer.appendChild(anchorElement);
  });
}

</script>