<script>
  $(document).ready(function () {
    function updateStates() {
      const data = $('#select_targeted_geographic_audience_org').select2('data');
      const countryCodes = data.map((s) => s.id)
      if ($('#select_targeted_geographic_audience_city_org').data('select2')) {
        console.log('select2 is destroyed');
        $('#select_targeted_geographic_audience_city_org').select2('val', '');
        $('#select_targeted_geographic_audience_city_org').select2('destroy');
        $("#select_targeted_geographic_audience_city_org").empty();
      }
      $.ajax({
        url: '/addresses/fetch_states',
        method: 'GET',
        data: { country_codes: countryCodes },
        dataType: 'json',
        success: function(data) {
          if ($('#select_targeted_geographic_audience_city_org').data('select2')) {
            $('#select_targeted_geographic_audience_city_org').select2('val', '');
            $('#select_targeted_geographic_audience_city_org').select2('destroy');
            $("#select_targeted_geographic_audience_city_org").empty();
          }
          $("#select_targeted_geographic_audience_city_org").select2({
            data: data
          }).trigger("change");
        }
      });
    }
    $('#select_targeted_geographic_audience_city_org').select2();
    $('#platforms_org').select2();
    $('#category_org').select2();
    $('#select_targeted_geographic_audience_org').select2();
    $('#select_targeted_geographic_audience_org').on('select2:select', () => {
      updateStates();
    })
    $('#select_targeted_geographic_audience_org').on('select2:unselect', () => {
      updateStates();
    });
  });
</script>

