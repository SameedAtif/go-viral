          <p class="mt-6 text-center text-sm text-gray-500">
            Don't have an account?
            <%= link_to "Register here", new_registration_path(resource_name), class: "font-semibold leading-6 text-indigo-600 hover:text-indigo-500" %>
          </p>
        </div>
      </div>
    </div>
  </div>
