<tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
    <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
        <%= public_send("#{verified_role.class.to_s.downcase}_transaction_description", transaction)%>
    </th>
    <td class="px-6 py-4">
        <%= format_transaction_time(transaction) %>
    </td>
    <td class="px-6 py-4">
        <%= public_send("format_#{verified_role.class.to_s.downcase}_transaction_amount", transaction) %>
    </td>
    <td class="px-6 py-4">
        <% status = public_send("#{verified_role.class.to_s.downcase}_transaction_status", transaction) %>
        <% if status == "completed" %>
            <span class='bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-green-400 border border-green-400'>completed</span>
        <% elsif status == "pending" %>
            <span class='bg-yellow-100 text-yellow-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-yellow-300 border border-yellow-300'>pending</span>
        <% elsif status == "refunded" %>
            <span class='bg-red-100 text-red-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-red-400 border border-red-400'>refunded</span>
        <% end %>
    </td>
</tr>
