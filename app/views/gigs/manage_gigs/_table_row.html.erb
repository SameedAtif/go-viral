<tr class="gig-table bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
  <td class="checkbox-column w-4 p-4">
    <div data-status="<%= status %>" class="checkbox-div flex items-center">
      <%= form.check_box :gigs, {
        multiple: true,
        class: "w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600",
        data: {status: status}
        }, gig.id, false %>
    </div>
  </td>
  <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
    <%= gig.title %>
  </th>
  <td class="px-6 py-4">
    <%= gig.gig_clients.accepted.count %>
  </td>
  <td class="px-6 py-4">
    <%= gig.gig_clients.rejected.count %>
  </td>
  <td class="px-6 py-4 text-right">
    <a href="#" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Details</a>
  </td>
  <td class="px-6 py-4 text-right">
    <a href="<%= edit_gig_path(gig) %>" class="font-medium text-blue-600 dark:text-blue-500 hover:underline">Edit</a>
  </td>
</tr>
