<div class="md:px-8 py-4">
    <h4 class="text-xl font-semibold pt-4">About the seller</h4>
    <div class="relative flex items-center space-x-3 py-5">
        <div class="flex-shrink-0">
            <img class="h-20 w-20 rounded-full"
                src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                alt="">
        </div>
        <div class="min-w-0 flex-1">
            <a href="#" class="focus:outline-none">
                <p class="flex">
                    <span class="text-lg font-medium text-gray-900">The Web Hulk</span>
                    <span class="mx-2 text-md text-zinc-500">@thewebhulk</span>
                </p>
                <p class="flex pt-1 items-center ">
                    <%= render partial: "shared/elements/filled_rating_star" , locals: { blank_star: false } %>
                        <span class="px-2 text-md font-medium text-gray-900">4.9</span>
                        <span class="pr-2 text-md text-zinc-500 underline border-r border-zinc-300">(137)</span>
                        <span class="px-2 text-md text-zinc-500">7 orders in queue</span>
                </p>
            </a>
        </div>
    </div>

    <div class="relative flex items-center pb-5">
        <button
            class="bg-white text-zinc-600 py-2 px-4 rounded-md hover:bg-zinc-600 hover:text-white flex justify-between items-center font-semibold group border border-zinc-600">
            Contact Me
        </button>
    </div>

    <div class="rounded-md border border-zinc-200 my-5 p-5">
        <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2 pb-4 border-b border-zinc-200">
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium">
                <div class="relative block cursor-pointer rounded-lg focus:outline-none">
                    <p id="size-choice-0-description" class="mt-1 text-base font-medium text-gray-500">From</p>
                    <p id="size-choice-0-label" class="text-base font-medium text-gray-900">India</p>
                </div>
            </div>
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium">
                <div class="relative block cursor-pointer rounded-lg focus:outline-none">
                    <p id="size-choice-0-description" class="mt-1 text-base font-medium text-gray-500">Member Since</p>
                    <p id="size-choice-0-label" class="text-base font-medium text-gray-900">Feb 2023</p>
                </div>
            </div>
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium">
                <div class="relative block cursor-pointer rounded-lg focus:outline-none">
                    <p id="size-choice-0-description" class="mt-1 text-base font-medium text-gray-500">Avg. response
                        time</p>
                    <p id="size-choice-0-label" class="text-base font-medium text-gray-900">1 hour</p>
                </div>
            </div>
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium">
                <div class="relative block cursor-pointer rounded-lg focus:outline-none">
                    <p id="size-choice-0-description" class="mt-1 text-base font-medium text-gray-500">Last delivery</p>
                    <p id="size-choice-0-label" class="text-base font-medium text-gray-900">about 2 hours ago</p>
                </div>
            </div>
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium">
                <div class="relative block cursor-pointer rounded-lg focus:outline-none">
                    <p id="size-choice-0-description" class="mt-1 text-base font-medium text-gray-500">Languages</p>
                    <p id="size-choice-0-label" class="text-base font-medium text-gray-900">English, Hindi, Punjabi</p>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 gap-x-6 gap-y-4 pt-4">
            <div
                class="flex w-full items-center justify-start rounded-md border border-transparent text-base font-medium text-gray-500">
                The Web Hulk provides expert website design, content writing, social media promotion, and Google Ad
                Campaign Management services. Our dedication to excellence has earned us recognition and features in
                media outlets such as Midday and The Startup Story.
            </div>
        </div>
    </div>
</div>