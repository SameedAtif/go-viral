            alt="" class="h-10 w-10 rounded-full bg-gray-100">
    </div>
    <div class="flex-1 py-10 <%= 'border-t border-gray-200' if (index > 2) %>">
        <h3 class="font-medium text-gray-900">Hector Gibbons</h3>
        <p><time datetime="2021-07-12">July 12, 2021</time></p>

        <div class="mt-4 flex items-center">
            <!-- Active: "text-yellow-400", Default: "text-gray-300" -->
            <%= render partial: "shared/elements/filled_rating_star" , locals: { blank_star: false } %>
                <%= render partial: "shared/elements/filled_rating_star" , locals: { blank_star: false } %>
                    <%= render partial: "shared/elements/filled_rating_star" , locals: { blank_star: false } %>
