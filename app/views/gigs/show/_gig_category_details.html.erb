<div class="md:mx-8 py-4">
    <div class="grid grid-cols-3 gap-3">
        <% if @gig.categories.present? %>
            <div class="">
                <p class="text-zinc-400">Audience Type</p>
                <p class="text-zinc-500"><%= @gig.categories.pluck(:name).join(', ') %></p>
            </div>
        <% end %>
        <% if @gig.platforms.present? %>
            <div class="">
                <p class="text-zinc-400">Plateform & tool</p>
                <p class="text-zinc-500"><%= @gig.platforms.pluck(:name).join(', ') %></p>
            </div>
        <% end %>
        <div class=""></div>
    </div>
</div>
