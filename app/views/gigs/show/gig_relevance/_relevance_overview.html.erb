<!-- component -->
<script src="https://cdn.jsdelivr.net/gh/alpinejs/alpine@v2.7.3/dist/alpine.min.js" defer></script>
<script>
  $(document).ready(() => {
    $('#<%= criteria %>-overview').click(
      () => {
        $('#<%= criteria %>-overview').hide();
        $('#<%= criteria %>-detail').show();
      }
    )
    $('#<%= criteria %>-detail').click(
      () => {
        $('#<%= criteria %>-overview').show();
        $('#<%= criteria %>-detail').hide();
      }
    )
  });
</script>
<div id="tooltip" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark:bg-gray-700">
    Click to view detail
    <div class="tooltip-arrow" data-popper-arrow></div>
</div>
<div class="flex mt-5 items-center flex-wrap max-w-md pl-10 bg-white shadow-xl rounded-2xl h-20"
    id="<%= criteria %>-overview"
    x-data="{ circumference: 50 * 2 * Math.PI, percent: <%= @gig_relevance.dig(criteria, :total_rating) * 10 %> }"
    data-tooltip-target="tooltip"
    >
      <div class="flex items-center justify-center -m-6 overflow-hidden bg-white rounded-full">
        <svg class="w-32 h-32 transform translate-x-1 translate-y-1" x-cloak aria-hidden="true">
          <circle
            class="text-gray-300"
            stroke-width="10"
            stroke="currentColor"
            fill="transparent"
            r="50"
            cx="60"
            cy="60"
            />
          <circle
            class="text-blue-600"
            stroke-width="10"
            :stroke-dasharray="circumference"
            :stroke-dashoffset="circumference - percent / 100 * circumference"
            stroke-linecap="round"
            stroke="currentColor"
            fill="transparent"
            r="50"
            cx="60"
            cy="60"
            />
        </svg>
        <span class="absolute text-2xl text-blue-700" x-text="`${percent}%`"></span>
      </div>
      <p class="ml-10 font-medium text-gray-600 sm:text-xl"><%= criteria.to_s.humanize.upcase.partition(" ").first %></p>
</div>
<div class="bg-white shadow-xl rounded-2xl p-3 hidden" id="<%= criteria %>-detail">
  <% @gig_relevance[criteria].reject { |k| k == :total_rating }.keys.each do |sub_criteria| %>
    <div class="flex justify-center">
      <p class="mr-2 min-w-20 font-medium text-gray-600"><%= sub_criteria.to_s.humanize.upcase %></p>
      <div class="w-full my-1 bg-gray-200 rounded-full dark:bg-gray-700">
        <div class="bg-blue-600 text-xs font-medium text-blue-100 text-center p-0.5 leading-none rounded-full" style="width: <%= @gig_relevance.dig(criteria, sub_criteria) * 100 %>%">
          <%= (@gig_relevance.dig(criteria, sub_criteria) * 100).round(2) %>%
        </div>
      </div>
    </div>
  <% end %>
</div>
