<%= javascript_include_tag "views/gigs/manage_gigs.js" %>

<div class="bg-white">
  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 sm:pb-24 lg:px-8">
    <div class="flex justify-between align-middle py-4">
      <h1 class="text-3xl font-thin">Gigs</h1>
      <div class="flex gap-4">
        <%= button_to "Create a Gig", new_gig_path, class: "text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-1 text-center dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-500 dark:focus:ring-blue-800", method: :get %>
      </div>
    </div>
    <div class="mb-4 border-b border-gray-200 dark:border-gray-700">
      <ul class="flex flex-wrap -mb-px text-sm font-medium text-center" id="default-tab" data-tabs-toggle="#default-tab-content" role="tablist">
        <% Gig::STATUSES.each do |status| %>
            <li class="me-2" role="presentation">
                <button
                  class="inline-block p-4 border-b-2 rounded-t-lg"
                  id="<%=status%>-tab"
                  data-tabs-target="#<%=status%>"
                  type="button"
                  role="tab"
                  aria-controls="<%=status%>"
                  aria-selected="false"
                >
                  <%= status.humanize.upcase %>
                </button>
            </li>
          <% end %>
        </ul>
    </div>
    <!--Tabs content-->
    <div id="default-tab-content">
      <%= form_with(url: bulk_gig_path, method: :delete) do |form| %>
        <% Gig::STATUSES.each do |status| %>
          <div class="hidden p-4 rounded-lg bg-gray-50 dark:bg-gray-800" id="<%= status %>" role="tabpanel" aria-labelledby="<%= status %>-tab">
            <div class="py-5 text-lg font-semibold text-left rtl:text-right text-gray-900 bg-gray-50 dark:bg-gray-800 dark:text-white">
              <div class="flex justify-between align-middle">
                <div>
                  <%= status.humanize.upcase %>
                </div>
                <div class="flex gap-4">
                  <div data-status="<%= status %>" class="delete-button">
                    <%= form.submit "Delete",
                      class: "py-2.5 px-5 me-2 mb-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700",
                      disabled: true,
                      data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }
                    %>
                  </div>
                </div>
              </div>
            </div>
            <div class="relative overflow-x-auto ">
              <%= render partial: 'gigs/manage_gigs/table', locals: { status: status, form: form } %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
