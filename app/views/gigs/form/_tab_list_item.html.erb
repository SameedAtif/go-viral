<li id="<%= tab_label %>-tab" data-tabs-target="#<%= tab_label %>" type="button" role="tab"
    aria-controls="<%= tab_label %>" aria-selected="false" role="presentation"
    class="py-4 px-16 shadow-button_custom rounded-3xl hover:cursor-pointer hover:bg-gray-100 hover:text-[#333] text-center">
    <button class="font-md">
        <%= tab_title %>
    </button>
</li>