</div>

<div data-tooltip-target="tooltip-platform" data-tooltip-placement="right" class=" mb-10">
  <div class="flex flex-row justify-between">
    <span>Select Platforms</span>
    <%= link_to_add_association "+ Add Platform" , f, :gig_platforms, partial: 'gigs/form/gig_platform_fields', class: "bg-white transition-colors duration-300 ease-in-out hover:bg-[#e0f0fe] text-gray-800 py-2 px-4 rounded-xl",
