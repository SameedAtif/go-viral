<div id="tooltip-categories" role="tooltip" class="!ml-12 absolute z-10 invisible inline-block px-6 py-4 text-sm font-medium text-gray-900 bg-white rounded-lg shadow-custom opacity-0 tooltip max-w-sm">
  <h3>Describe your Gig</h3>
  <ol>
    <li>
      As your Gig storefront, your title is the most important place to include keywords that buyers would likely use to search for a service like yours.
    </li>
    <li>
      This is your Gig title. Choose wisely, you can only use 80 characters.
    </li>
  </ol>
  <div class="tooltip-arrow" data-popper-arrow></div>
</div>

<script>
  function renderSlider() {
    var slider = document.getElementById('rangeSlider');
    var valuesDiv = document.getElementById('sliderValues');

    var gig_targeted_demographic_start_age = document.getElementById("gig_targeted_demographic_start_age");
    var gig_targeted_demographic_end_age = document.getElementById("gig_targeted_demographic_end_age")


    noUiSlider.create(slider, {
      start: [<%= @gig.targeted_demographic_start_age %>, <%= @gig.targeted_demographic_end_age %>],
      connect: true,
      step: 1,
      range: {
        'min': 0,
        'max': 100
      },
      tooltips: [true, true]
    });

    // Function to update the displayed values
    function updateValues() {
      var values = slider.noUiSlider.get();

      gig_targeted_demographic_start_age.value = values[0]
      gig_targeted_demographic_end_age.value = values[1]

    }

    // Listen for changes and update the values
    slider.noUiSlider.on('update', function () {
      updateValues();
    });

    // Initial update
    updateValues();
  }

</script>
<!-- Include the nouislider JavaScript -->
<script src="https://unpkg.com/nouislider@14.6.4/distribute/nouislider.min.js" onload="renderSlider()"></script>

