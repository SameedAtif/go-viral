<%= javascript_include_tag "views/gigs/form" %>
<div class="bg-gray-100">
    <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 sm:pb-24 lg:px-8 pt-4">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="md:col-span-1">
                <ul class="flex flex-col vertical-tabs p-4 bg-white h-fit rounded-md gap-y-4 py-8 shadow-custom"
                    id="default-tab" data-tabs-toggle="#default-tab-content" role="tablist">
                    <%= render partial: 'gigs/form/tab_list_item' , locals: { tab_label: "basic", tab_title: "Basic Information" } %>
                    <%= render partial: 'gigs/form/tab_list_item' , locals: { tab_label: "package", tab_title: "Gig Packages" } %>
                    <%= render partial: 'gigs/form/tab_list_item' , locals: { tab_label: "faq", tab_title: "Gig FAQs" } %>
                </ul>
            </div>
            <div class="md:col-span-2">
                <%= form_with model: @gig, local: true, class: "rounded-md py-4 px-12 bg-white mx-auto shadow-custom" do |f| %>
                    <div id="basic" role="tabpanel" aria-labelledby="basic-tab" class="tab-content">
                        <%= render partial: 'gigs/form/basic_information_form' , locals: {f: f} %>
                    </div>
                    <div id="package" class="contains_nested_fields package_fields tab-content" role="tabpanel" aria-labelledby="package-tab">
                        <div class="flex justify-between my-6">
                            <h3 class="text-lg font-bold text-gray-900 mb-2">Package Tab</h3>
                            <span>
                                <%= link_to_add_association "+ Add Package" , f, :gig_packages, class: "bg-white transition-colors duration-300 ease-in-out hover:bg-[#e0f0fe] text-gray-800 py-2 px-4 rounded-xl",
                                    id: 'add_new_package',
                                    partial: 'gigs/form/gig_package_fields' , data: {
                                    association_insertion_node: '.gig_packages' ,
                                    association_insertion_method: :append } %>
                            </span>
                        </div>

                        <div class="gig_packages" id="accordion-nested-parent" data-accordion="collapse">
                            <%= f.fields_for :gig_packages do |package| %>
                                <%= render 'gigs/form/gig_package_fields' , f: package %>
                            <% end %>
                        </div>
                    </div>
                    <div id="faq" class="contains_nested_fields faq_fields tab-content" role="tabpanel" aria-labelledby="faq-tab">
                        <div class="flex justify-between my-6">
                            <h3 class="text-lg font-bold text-gray-900 mb-2">FAQ Tab</h3>
                            <span>
                                <%= link_to_add_association "+ Add FAQ" , f, :gig_faqs, class: "bg-white transition-colors duration-300 ease-in-out hover:bg-[#e0f0fe] text-gray-800 py-2 px-4 rounded-xl",
                                    partial: 'gigs/form/gig_faq_fields' , data: {
                                    association_insertion_node: '.gig_faqs' , association_insertion_method:
                                    :append } %>
                            </span>
                        </div>

                        <div class="gig_faqs">
                            <div id="accordion-nested-parent" data-accordion="collapse">
                                <%= f.fields_for :gig_faqs do |faq| %>
                                    <%= render 'gigs/form/gig_faq_fields' , f: faq %>
                                <% end %>
                            </div>
                        </div>
                    </div>
                    <div class="flex justify-end gap-4 py-4">
                        <%= f.submit "Save as Draft" , name: "draft", class:"py-2 px-4 rounded-md bg-white transition-colors duration-300 ease-in-out hover:bg-[#e0f0fe] text-gray-800 " , onclick: "validateForm(event)" %>
                        <%= f.submit "Publish" , name: "publish", class:"py-2 px-4 rounded-md text-white bg-gray-800 cursor-pointer" , onclick: "validateForm(event)" %>
                    </div>
                <% end %>
            </div>
            <div class="hidden md:block md:col-span-1">
                <div class="inline-block px-6 py-4 text-sm font-medium text-gray-900 bg-[#e0f0fe] rounded-lg shadow-custom border border-sky-500" id="basic-gig-details">
                    <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">Start Defining your Gig</h3>
                    <ul class="list-disc list-inside text-gray-500 dark:text-gray-400 space-y-1">
                        <li>
                            Create a catchy title.
                        </li>
                        <li>
                            Add meta data to help buyers find more information regarding your Gig.
                        </li>
                        <li>
                            Add tags to help buyers find your Gig while searching.
                        </li>
                        <li>
                            Choose Your Success: Select a Package Tailored to Elevate Your Experience!
                        </li>
                        <li>
                            Find Your Clarity: Explore FAQs to add Instant Answers to basic Queries!
                        </li>
                    </ul>
                  </div>
            </div>
        </div>
    </div>
</div>
