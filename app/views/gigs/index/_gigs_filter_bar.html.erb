<div class="bg-gray-100">
  <!--
    Mobile filter dialog

    Off-canvas filters for mobile, show/hide based on off-canvas filters state.
  -->
  <div class="relative z-40 hidden" id="gigs_search_filters" role="dialog" aria-modal="true" tabindex="-1"
    aria-hidden="true">
    <!--
      Off-canvas menu backdrop, show/hide based on off-canvas menu state.

      Entering: "transition-opacity ease-linear duration-300"
        From: "opacity-0"
        To: "opacity-100"
      Leaving: "transition-opacity ease-linear duration-300"
        From: "opacity-100"
        To: "opacity-0"
    -->
    <div class="fixed inset-0 bg-black bg-opacity-25"></div>

    <div class="fixed inset-0 z-40 flex">
      <!--
        Off-canvas menu, show/hide based on off-canvas menu state.

        Entering: "transition ease-in-out duration-300 transform"
          From: "translate-x-full"
          To: "translate-x-0"
        Leaving: "transition ease-in-out duration-300 transform"
          From: "translate-x-0"
          To: "translate-x-full"
      -->
      <div class="relative ml-auto flex h-full w-full max-w-xs flex-col overflow-y-auto bg-white py-4 pb-12 shadow-xl">
        <div class="flex items-center justify-between px-4">
          <h2 class="text-lg font-medium text-gray-900">Filters</h2>
          <button type="button" data-dropdownToggle="gigs_search_filters"
            class="dropdownNavbarLink -mr-2 flex h-10 w-10 items-center justify-center rounded-md bg-white p-2 text-gray-400">
            <span class="sr-only">Close menu</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
              aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Filters -->
        <form class="mt-4">
          <div class="border-t border-gray-200 px-4 py-6">
            <h3 class="-mx-2 -my-3 flow-root">
              <!-- Expand/collapse section button -->
              <button type="button"
                class="flex w-full items-center justify-between bg-white px-2 py-3 text-sm text-gray-400"
                aria-controls="filter-section-0" aria-expanded="false">
                <span class="font-medium text-gray-900">Select Platform</span>
                <span class="ml-6 flex items-center">
                  <!--
                    Expand/collapse icon, toggle classes based on section open state.

                    Open: "-rotate-180", Closed: "rotate-0"
                  -->
                  <svg class="rotate-0 h-5 w-5 transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd" />
                  </svg>
                </span>
              </button>
            </h3>
            <!-- Filter section, show/hide based on section state. -->
            <div class="pt-6" id="filter-section-0">
              <div class="space-y-6">
                <div class="flex items-center">
                  <input id="filter-mobile-category-0" name="category[]" value="new-arrivals" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-category-0" class="ml-3 text-sm text-gray-500">All New Arrivals</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-category-1" name="category[]" value="tees" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-category-1" class="ml-3 text-sm text-gray-500">Tees</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-category-2" name="category[]" value="objects" type="checkbox" checked
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-category-2" class="ml-3 text-sm text-gray-500">Objects</label>
                </div>
              </div>
            </div>
          </div>
          <div class="border-t border-gray-200 px-4 py-6">
            <h3 class="-mx-2 -my-3 flow-root">
              <!-- Expand/collapse section button -->
              <button type="button"
                class="flex w-full items-center justify-between bg-white px-2 py-3 text-sm text-gray-400"
                aria-controls="filter-section-1" aria-expanded="false">
                <span class="font-medium text-gray-900">Date Posted</span>
                <span class="ml-6 flex items-center">
                  <!--
                    Expand/collapse icon, toggle classes based on section open state.

                    Open: "-rotate-180", Closed: "rotate-0"
                  -->
                  <svg class="rotate-0 h-5 w-5 transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd" />
                  </svg>
                </span>
              </button>
            </h3>
            <!-- Filter section, show/hide based on section state. -->
            <div class="pt-6" id="filter-section-1">
              <div class="space-y-6">
                <div class="flex items-center">
                  <input id="filter-mobile-color-0" name="color[]" value="white" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-color-0" class="ml-3 text-sm text-gray-500">White</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-color-1" name="color[]" value="beige" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-color-1" class="ml-3 text-sm text-gray-500">Beige</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-color-2" name="color[]" value="blue" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-color-2" class="ml-3 text-sm text-gray-500">Blue</label>
                </div>
              </div>
            </div>
          </div>
          <div class="border-t border-gray-200 px-4 py-6">
            <h3 class="-mx-2 -my-3 flow-root">
              <!-- Expand/collapse section button -->
              <button type="button"
                class="flex w-full items-center justify-between bg-white px-2 py-3 text-sm text-gray-400"
                aria-controls="filter-section-2" aria-expanded="false">
                <span class="font-medium text-gray-900">Select Location</span>
                <span class="ml-6 flex items-center">
                  <!--
                    Expand/collapse icon, toggle classes based on section open state.

                    Open: "-rotate-180", Closed: "rotate-0"
                  -->
                  <svg class="rotate-0 h-5 w-5 transform" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd" />
                  </svg>
                </span>
              </button>
            </h3>
            <!-- Filter section, show/hide based on section state. -->
            <div class="pt-6" id="filter-section-2">
              <div class="space-y-6">
                <div class="flex items-center">
                  <input id="filter-mobile-sizes-0" name="sizes[]" value="s" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-sizes-0" class="ml-3 text-sm text-gray-500">S</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-sizes-1" name="sizes[]" value="m" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-sizes-1" class="ml-3 text-sm text-gray-500">M</label>
                </div>
                <div class="flex items-center">
                  <input id="filter-mobile-sizes-2" name="sizes[]" value="l" type="checkbox"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="filter-mobile-sizes-2" class="ml-3 text-sm text-gray-500">L</label>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <section aria-labelledby="filter-heading">
    <h2 id="filter-heading" class="sr-only">Filters</h2>

    <div id="filters_nav_bar" class="bg-white filter_bar border-b border-gray-200 py-4">
      <div class="mx-auto flex max-w-screen-2xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="hidden md:block">
          <div class="flow-root">
            <div class="relative inline-block pr-2 text-left">
              <button id="platform_filter" data-dropdown-toggle="platform_filter_menu" type="button"
                class="group py-2 px-4 rounded-lg border border-zinc-300 gap-2 bg-white inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900"
                aria-expanded="false" aria-haspopup="true">
                <span>Select Platform</span>
                <svg class="-mr-1 ml-1 h-5 w-5 flex-shrink-0 text-gray-400 group-hover:text-gray-500"
                  viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd" />
                </svg>
              </button>
              <div id="platform_filter_menu"
                class="absolute hidden  right-0 z-10 mt-2 origin-top-right rounded-md bg-white p-4 shadow-2xl ring-1 ring-black ring-opacity-5 focus:outline-none"
                role="menu" aria-orientation="vertical" tabindex="-1">
                <form id="platform_filter_form" class="space-y-4">
                  <% @platforms.each do |platform| %>
                    <div class="flex items-center">
                      <input id="<%= platform.id %>" name="platform[]" value="<%= platform.id %>" type="checkbox"
                        class="platform-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                      <label for="<%= platform.id %>"
                        class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900"><%= platform.name %></label>
                    </div>
                  <% end %>
                </form>
            </div>
            </div>
            <div class="relative inline-block px-2 text-left">
              <button id="date_filter" data-dropdown-toggle="date_filter_menu" type="button"
                class="group py-2 px-4 rounded-lg border border-zinc-300 gap-2 bg-white inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900"
                aria-expanded="false" aria-haspopup="true">
                <span>Date Posted</span>
                <svg class="-mr-1 ml-1 h-5 w-5 flex-shrink-0 text-gray-400 group-hover:text-gray-500"
                  viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd"
                    d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                    clip-rule="evenodd" />
                </svg>
              </button>
              <div id="date_filter_menu"
                class="absolute hidden right-0 z-10 mt-2 origin-top-right rounded-md bg-white p-4 shadow-2xl ring-1 ring-black ring-opacity-5 focus:outline-none"
                role="menu" aria-orientation="vertical" tabindex="-1">
                <form class="date_filter_form space-y-4">
                  <div class="flex items-center">
                    <input id="filter-color-0" name="date[]" value="last_24_hours" type="checkbox"
                      class="date-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="filter-color-0"
                      class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900">Last 24 Hours</label>
                  </div>
                  <div class="flex items-center">
                    <input id="filter-color-1" name="date[]" value="last_week" type="checkbox"
                      class="date-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="filter-color-1"
                      class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900">Last Week</label>
                  </div>
                  <div class="flex items-center">
                    <input id="filter-color-2" name="date[]" value="last_month" type="checkbox"
                      class="date-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="filter-color-2"
                      class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900">Last Month</label>
                  </div>
                </form>
              </div>
            </div>
          <div class="relative inline-block pr-2 text-left">
            <button id="category_filter" data-dropdown-toggle="category_filter_menu" type="button"
              class="group py-2 px-4 rounded-lg border border-zinc-300 gap-2 bg-white inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900"
              aria-expanded="false" aria-haspopup="true">
              <span>Select Category</span>
              <svg class="-mr-1 ml-1 h-5 w-5 flex-shrink-0 text-gray-400 group-hover:text-gray-500"
                viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd" />
              </svg>
            </button>
            <div id="category_filter_menu"
              class="absolute hidden  right-0 z-10 mt-2 origin-top-right rounded-md bg-white p-4 shadow-2xl ring-1 ring-black ring-opacity-5 focus:outline-none"
              role="menu" aria-orientation="vertical" tabindex="-1">
              <form id="category_filter_form" class="space-y-4">
                <% @categories.each do |category| %>
                  <div class="flex items-center">
                    <input id="<%= category.id %>" name="category[]" value="<%= category.id %>" type="checkbox"
                      class="category-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="<%= category.id %>"
                      class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900"><%= category.name %></label>
                  </div>
                <% end %>
              </form>
            </div>
          </div>
        <div class="relative inline-block pr-2 text-left">
          <button id="country_filter" data-dropdown-toggle="country_filter_menu" type="button"
            class="group py-2 px-4 rounded-lg border border-zinc-300 gap-2 bg-white inline-flex justify-center text-sm font-medium text-gray-700 hover:text-gray-900"
            aria-expanded="false" aria-haspopup="true">
            <span>Select Country</span>
            <svg class="-mr-1 ml-1 h-5 w-5 flex-shrink-0 text-gray-400 group-hover:text-gray-500"
              viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd"
                d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                clip-rule="evenodd" />
            </svg>
          </button>
          <div id="country_filter_menu"
            class="absolute hidden  right-0 z-10 mt-2 origin-top-right rounded-md bg-white p-4 shadow-2xl ring-1 ring-black ring-opacity-5 focus:outline-none"
            role="menu" style="max-height: 200px; overflow-y: auto;" aria-orientation="vertical" tabindex="-1">
            <form id="country_filter_form" class="space-y-4">
              <% ISO3166::Country.pluck(:iso_short_name).map(&:first).each do |country| %>
                <div class="flex items-center">
                  <input id="<%= country %>" name="country[]" value="<%= country %>" type="checkbox"
                    class="country-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                  <label for="<%= country %>"
                    class="ml-3 whitespace-nowrap pr-6 text-sm font-medium text-gray-900"><%= country %></label>
                </div>
              <% end %>
            </form>
          </div>
        </div>
          </div>
        </div>

        <!-- Mobile filter dialog toggle, controls the 'mobileFiltersOpen' state. -->
        <button type="button" class="inline-block text-sm font-medium text-gray-700 hover:text-gray-900 md:hidden"
          data-modal-target="gigs_search_filters" data-modal-toggle="gigs_search_filters">Filters</button>

        <div class="flow-root">

          <div class="relative inline-block text-left">
            <div>
              <button type="button"
                class="dropdownNavbarLink group rounded-lg borde gap-2 text-blue-600 inline-flex justify-center text-sm font-medium hover:text-blue-400 mr-4"
                id="clear-all-button" data-dropdownToggle="sort_drop_down" aria-expanded="false" aria-haspopup="true">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                  stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <%= t("body.filter_bar.clear_all") %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Active filters -->
    <div class="bg-gray-100">
      <div class="mx-auto max-w-screen-2xl px-4 py-3 sm:flex sm:items-center sm:px-6 lg:px-8">
        <h3 class="text-sm font-medium text-gray-500">
          Filters
          <span class="sr-only">, active</span>
        </h3>

        <div aria-hidden="true" class="hidden h-5 w-px bg-gray-300 sm:ml-4 sm:block"></div>

        <div class="mt-2 sm:ml-4 sm:mt-0">
          <div class="-m-1 flex flex-wrap items-center">
            <% if params[:date_filter_option].present? && params[:date_filter_option].is_a?(Array) %>
              <% params[:date_filter_option].each do |option| %>
                <span class="m-1 inline-flex items-center rounded-full border border-gray-200 bg-white py-1.5 pl-3 pr-2 text-sm font-medium text-gray-900">
                  <span><%= option.titleize %></span>
                  <button type="button" data-option="<%= option %>" class="remove-filter ml-1 inline-flex h-4 w-4 flex-shrink-0 rounded-full p-1 text-gray-400 hover:bg-gray-200 hover:text-gray-500">
                    <span class="sr-only">Remove filter for <%= option.titleize %></span>
                    <svg class="h-2 w-2" stroke="currentColor" fill="none" viewBox="0 0 8 8">
                      <path stroke-linecap="round" stroke-width="1.5" d="M1 1l6 6m0-6L1 7" />
                    </svg>
                  </button>
                </span>
              <% end %>
            <% end %>
            <% if params[:platform].present? && params[:platform].is_a?(Array) %>
              <% params[:platform].each do |platform| %>
                <span class="m-1 inline-flex items-center rounded-full border border-gray-200 bg-white py-1.5 pl-3 pr-2 text-sm font-medium text-gray-900">
                  <span><%= platform.titleize %></span>
                  <button type="button" data-platform="<%= platform %>" class="remove-filter ml-1 inline-flex h-4 w-4 flex-shrink-0 rounded-full p-1 text-gray-400 hover:bg-gray-200 hover:text-gray-500">
                    <span class="sr-only">Remove filter for <%= platform.titleize %></span>
                    <svg class="h-2 w-2" stroke="currentColor" fill="none" viewBox="0 0 8 8">
                      <path stroke-linecap="round" stroke-width="1.5" d="M1 1l6 6m0-6L1 7" />
                    </svg>
                </button>
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
<script>
$(document).ready(function() {
  document.querySelectorAll('.remove-filter').forEach(function(button) {
    button.addEventListener('click', function() {
      const option = this.dataset.option || this.dataset.platform;
      const params = new URLSearchParams(window.location.search);
      if (params.has('date_filter_option')) {
        const options = params.getAll('date_filter_option');
        params.delete('date_filter_option');
        options.filter(o => o !== option).forEach(o => params.append('date_filter_option', o));
      }
      if (params.has('platform')) {
        const platforms = params.getAll('platform');
        params.delete('platform');
        platforms.filter(p => p !== option).forEach(p => params.append('platform', p));
      }
      window.location.search = params.toString();
    });
  });
  function fetchData(platformIds=[], dates=[], categoryIds=[], countryIds=[]) {
    $.ajax({
      url: '/gigs',
      method: 'GET',
      data: { platform: platformIds, date_filter_option: dates, category: categoryIds, country: countryIds },
      dataType: 'script',
      success: function(response) {},
      error: function(xhr, status, error) {
        console.error('Error:', error);
      }
    });
  }

  $('.platform-checkbox, .date-checkbox, .category-checkbox, .country-checkbox').on('change', function() {
    var platformCheckedValues = [];
    var dateCheckedValues = [];
    var categoryCheckedValues = [];
    var countryCheckedValues = [];
    $('.platform-checkbox:checked').each(function() {
      platformCheckedValues.push($(this).val());
    });
    $('.date-checkbox:checked').each(function() {
      dateCheckedValues.push($(this).val());
    });
    $('.category-checkbox:checked').each(function() {
      categoryCheckedValues.push($(this).val());
    });
    $('.country-checkbox:checked').each(function() {
      countryCheckedValues.push($(this).val());
    });
    fetchData(platformCheckedValues, dateCheckedValues, categoryCheckedValues, countryCheckedValues);
  });
  $('#platform_filter').on('click', function() {
    $('#platform_filter_menu').toggleClass('hidden');
  });
  $('#category_filter').on('click', function() {
    $('#category_filter_menu').toggleClass('hidden');
  });
  $('#country_filter').on('click', function() {
    $('#country_filter_menu').toggleClass('hidden');
  });
  $(document).on('click', '#platform_filter_menu ul a', function(e) {
    e.preventDefault();
    $('#platform_filter_menu').addClass('hidden');
  });
  $('#date_filter').on('click', function() {
    $('#date_filter_menu').toggleClass('hidden');
  });
  $(document).on('click', '#date_filter_menu ul a', function(e) {
    e.preventDefault();
    $('#date_filter_menu').addClass('hidden');
  });
  $(document).on('click', '#category_filter_menu ul a', function(e) {
    e.preventDefault();
    $('#category_filter_menu').addClass('hidden');
  });
  $(document).on('click', '#country_filter_menu ul a', function(e) {
    e.preventDefault();
    $('#country_filter_menu').addClass('hidden');
  });
  const clearAllButton = document.getElementById('clear-all-button');
  if (clearAllButton) {
    clearAllButton.addEventListener('click', function() {
      const url = window.location.href.split('?')[0];
      window.location.href = url;
    });
  }
});

</script>
