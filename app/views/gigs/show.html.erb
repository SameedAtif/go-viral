<% content_for :title, @gig.title %>
<% navigation_add 'Gigs' , gigs_path %>
<% content_for :include_js_files do %>
    <%= javascript_include_tag "gigs/counter" %>
<% end %>

<div class="bg-white">
    <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 sm:pb-24 lg:px-8">
        <div class="flex flex-col lg:flex-row">
            <div class="w-full lg:w-3/5 bg-white p-4 overflow-y-auto">
                <div class="my-6">
                    <%= render_navigation %>
                </div>
                <div class="md:px-8 py-4">
                    <h4 class="text-3xl font-bold"><%= @gig.title%></h4>
                    <div class="relative flex items-center space-x-3 py-5">
                        <div class="flex-shrink-0">
                            <img class="h-16 w-16 rounded-full"
                                src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=facearea&facepad=2&w=256&h=256&q=80"
                                alt="">
                        </div>
                        <div class="min-w-0 flex-1">
                            <a href="#" class="focus:outline-none">
                                <p class="flex">
                                    <span class="text-lg font-medium text-gray-900"><%= @gig.influencer.stage_name %></span>
                                    <span class="mx-2 text-md text-zinc-500">@<%= @gig.influencer.stage_name %></span>
                                </p>
                                <p class="flex pt-1 items-center ">
                                    <%= render partial: "shared/elements/filled_rating_star" ,
                                        locals: { blank_star: false } %>
                                        <span
                                            class="px-2 text-md font-medium text-gray-900"><%= @influencer_rating %></span>
                                        <span
                                            class="pr-2 text-md text-zinc-500 underline border-r border-zinc-300">(<%= @influencer_completed_orders %>)</span>
                                        <span class="px-2 text-md text-zinc-500"><%= @influencer_ongoing_orders %> orders in
                                            queue</span>
                                </p>
                            </a>
                        </div>
                    </div>
                </div>


                <%= render partial: "gigs/show/image_slider_carousel/image_slider_carousel" %>
                <%# render partial: "gigs/show/preview_reviews" %>
                <%= render partial: "gigs/show/gig_long_description" %>
                <%= render partial: "gigs/show/gig_category_details" %>
                <%= render partial: "gigs/show/about_seller" %>
                <%# render partial: "gigs/show/compare_packages" %>
                <%# render partial: "gigs/show/reviews" %>
                <%# render partial: "gigs/show/gig_reviews" %>
            </div>
            <div
                class="w-full lg:block lg:w-2/5 lg:flex-1 bg-white p-4 overflow-y-auto lg:sticky lg:top-0 lg:self-start">
                <%= render "gigs/show/package_overview" , locals: {
                    responsive_layout_id: 'web_view_package_content' } %>
            </div>
            <div id="drawer-right-example"
                class="fixed top-0 right-0 z-40 h-screen p-4 overflow-y-auto transition-transform translate-x-full bg-white min-w-sm"
                tabindex="-1" aria-labelledby="drawer-right-label">
                <h5 id="drawer-label"
                    class="inline-flex items-center mb-4 text-base font-semibold text-gray-500">
                    <svg class="w-4 h-4 mr-2.5" aria-hidden="true"
                        xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
                        <path
                            d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z" />
                    </svg>Order Options
                </h5>
                <button type="button" data-drawer-hide="drawer-right-example"
                    aria-controls="drawer-right-example"
                    class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 absolute top-2.5 right-2.5 inline-flex items-center justify-center">
                    <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
                        fill="none" viewBox="0 0 14 14">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                            stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
                    </svg>
                    <span class="sr-only">Close menu</span>
                </button>
                <div class="flex flex-col justify-between h-screen" style="height: 92vh;">
                    <div>
                        <h1 id="selected-gig-tab-title">Basic</h1>
                        <p class="mb-6 text-sm text-gray-500">
                            <strong id="selected-gig-title"><%= @gig.gig_packages.first.title %>
                        </p>

                        <h1 class="px-2 py-4">How often do you need this order</h1>
                        <div class="border-2 border-gray-900 rounded-xl p-2">
                            <div class="flex w-full justify-between p-2 border-b border-gray-300">
                                <p>Single order</p>
                                <p>$<span id="gig-price"><%= @gig.gig_packages.first.title %></span></p>
                            </div>
                            <div class="flex w-full justify-between p-2">
                                <p>Gigs Quantity</p>
                                <div>
                                    <div class="flex items-center space-x-4">
                                        <span id="counter" class="text-xl font-bold">1</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <p class="py-4 text-sm text-gray-500">
                            <%= @gig.gig_packages.first.description %>
                        </p>
                    </div>
                    <% if current_user&.influencer != @gig.influencer %>
                        <div class="flex w-full">

                            <%= button_to gig_package_system_gig_transactions_path(@gig.gig_packages.first),
                                form: { id: 'buy-package' },
                                class: "flex w-full items-center px-4 py-4 text-sm font-medium justify-center text-white bg-black rounded-lg hover:bg-gray-700",
                                method: :post do %>
                                Continue
                                ($<span id="total-gigs-price"><%= @gig.gig_packages.first.price %></span>)
                            <% end %>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>
    </div>
</div>
