<div class="bg-gradient-to-b from-[#e0f0fe] to-white ">
  <div class="mx-auto max-w-screen-2xl">
    <div class="relative isolate overflow-hidden px-6 py-24 sm:px-24 xl:py-32">
        <div class="absolute left-52 top-30 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Instagram.png"), alt: 'My Image') %>
        </div>
        <div class="absolute right-48 top-30 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Facebook.png"), alt: 'My Image') %>
        </div>
        <div class="absolute left-64 top-2/3 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/WeChat.png"), alt: 'My Image') %>
        </div>
        <div class="absolute left-0 top-3/4 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Snapchat.png"), alt: 'My Image') %>
        </div>
        <div class="absolute right-1/4 top-1/2 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Telegram.png"), alt: 'My Image') %>
        </div>
        <div class="absolute left-32 top-2/3 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Tiktok.png"), alt: 'My Image') %>
        </div>
        <div class="absolute right-0 top-1/4 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Twitter.png"), alt: 'My Image') %>
        </div>
        <div class="absolute left-20 top-36 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Whatsapp.png"), alt: 'My Image') %>
        </div>
        <div class="absolute right-36 top-2/3 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Youtube.png"), alt: 'My Image') %>
        </div>
        <div class="absolute right-0 bottom-12 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Reddit.png"), alt: 'My Image') %>
        </div>
        <div class="absolute left-3/4 top-3/4 transform -translate-y-1/2">
            <%= image_tag(asset_url("home_page_banner_assets/Line.png"), alt: 'My Image') %>
        </div>
        <h2 class="mx-auto max-w-2xl text-center text-3xl font-bold tracking-tight text-neutral-600 sm:text-4xl">Find The Perfect Creator</h2>
        <p class="mx-auto mt-2 max-w-xl text-center text-lg leading-8  text-neutral-600">for your business</p>
        <form class="mx-auto mt-10 flex max-w-lg gap-x-4">
            <label for="search" class="mb-2 text-sm font-medium text-gray-900 sr-only dark:text-white">Search</label>
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
                    </svg>
                </div>
                <input type="search" id="search" class="block w-full p-4 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-white focus:ring-blue-500 focus:border-blue-500" placeholder="Search your influencer" required>
            </div>
        </form>

    </div>
  </div>
</div>
