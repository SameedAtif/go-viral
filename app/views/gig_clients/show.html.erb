<div class="space-y-2 px-4 sm:flex sm:items-baseline sm:justify-between sm:space-y-0 sm:px-0">
  <div class="flex justify-between w-full">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Order #<%= @gig_client.id %></h1>
    </div>
    <% if verified_role.is_a?(Influencer) && @gig_client.status.blank? %>
      <div class="flex space-x-4">
        <%=
          button_to "Accept", gig_client_path(@gig_client),
          class: "text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-1 text-center dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-500 dark:focus:ring-blue-800",
          method: :put,
          params: { gig_client: { status: ::GigClient::STATUSES_MAP[:accepted] } }
        %>
        <%=
          button_to "Decline", gig_client_path(@gig_client),
          class: "text-blue-700 hover:text-white border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-1 text-center dark:border-blue-500 dark:text-blue-500 dark:hover:text-white dark:hover:bg-blue-500 dark:focus:ring-blue-800",
          method: :put,
          params: { gig_client: { status: ::GigClient::STATUSES_MAP[:rejected] } }
        %>
      </div>
    <% end %>
  </div>
  <% if @gig_client.status.present? %>
    <p class="text-sm text-gray-600">Order <%= @gig_client.status == ::GigClient::STATUSES_MAP[:accepted] ? 'placed' : 'declined'%></p>
  <% end %>
</div>

<div class="flex flex-row p-4">
    <ul class="flex-column space-y space-y-4 text-sm font-medium md:me-4 mb-4 md:mb-0 min-w-80" id="default-tab" data-tabs-toggle="#default-tab-content" role="tablist">
        <li role="presentation">
            <button
                id="basic-tab"
                data-tabs-target="#basic"
                type="button"
                role="tab"
                aria-controls="basic"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Order Detail
            </button>
        </li>
        <li role="presentation">
            <button
                id="platform-tab"
                data-tabs-target="#platform"
                type="button"
                role="tab"
                aria-controls="platform"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Manage Order Deliverables
            </button>
        </li>
        <li role="presentation">
            <button
                id="portfolio-tab"
                data-tabs-target="#portfolio"
                type="button"
                role="tab"
                aria-controls="portfolio"
                aria-selected="false"
                class="inline-flex items-center px-4 py-3 rounded-lg w-full">
                Request help
            </button>
        </li>
    </ul>
    <div class="p-6 text-medium rounded-lg w-full">
      <div id="basic" role="tabpanel" aria-labelledby="basic-tab" class="tab-content">
        <%= render partial: 'gig_clients/show/order_info' %>
      </div>
      <div id="platform" role="tabpanel" aria-labelledby="platform-tab" class="tab-content">
        <div class="block p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
          <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Submit work</h5>
          <div class="flex justify-between w-full">
            <div>
              <p class="font-normal text-gray-700 dark:text-gray-400">Submit work for client to review</p>
            </div>
            <div class="flex space-x-4">
              <%= @gig_client.gig_deliverables.count %> / <%= @gig_package.review_limit %> revisions used
            </div>
          </div>
          <div>
            <%= form_with model: GigDeliverable.new, url: gig_client_gig_deliverables_path(@gig_client), local: true do |f| %>
              <div class="mb-5">
                <%= f.label :title, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
                <%= f.text_field :title, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "Awesome Gig", required: true %>
              </div>
              <div class="mb-5">
                <%= f.label :description, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
                <%= f.rich_text_area :description, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "Awesome Gig", required: true %>
              </div>
              <div class="mb-5">
                <%= f.label 'Upload work', class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
                <%= f.file_field :work_files, multiple: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "Awesome Gig", required: true %>
              </div>
              <%= f.submit %>
            <% end %>
          </div>
        </div>
        <div class="block mt-2 p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700">
          <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Past Submissions</h5>
          <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
              <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
                  <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                    <tr>
                      <th scope="col" class="px-6 py-3">
                          Title
                      </th>
                      <th scope="col" class="px-6 py-3">
                          Description
                      </th>
                      <th scope="col" class="px-6 py-3">
                          Submission Time
                      </th>
                      <th scope="col" class="px-6 py-3">
                          Status
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    <% @gig_client.gig_deliverables.each do |deliverable| %>
                      <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                        <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
                          <%= deliverable.title %>
                        </th>
                        <td class="px-6 py-4">
                          <%= deliverable.description.html_safe %>
                        </td>
                        <td class="px-6 py-4">
                          <%= time_ago_in_words(deliverable.created_at) %>
                        </td>
                        <td class="px-6 py-4">
                            <%= deliverable.gig_deliverable_reviews.first.present? ? deliverable.gig_deliverable_reviews.first.status : 'Not responded' %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
              </table>
          </div>

        </div>
      </div>
      <div id="portfolio" role="tabpanel" aria-labelledby="portfolio-tab" class="tab-content">
        <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">Portfolio Tab</h3>
      </div>
    </div>
</div>
