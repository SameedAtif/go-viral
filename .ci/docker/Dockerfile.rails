FROM ruby:3.2.1
ARG BUNDLER_VERSION=2.4.6
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get --allow-releaseinfo-change-suite update && apt-get install -y --no-install-recommends apt-utils

#Postgresql
RUN apt-get install -y libpq-dev

#Nokogiri
RUN apt-get install -y libxml2-dev libxslt1-dev

RUN apt-get --allow-releaseinfo-change-suite update && apt-get install -y \
      curl \
      openssl \
      python \
      cmake \
      build-essential \
      nodejs \
      npm

RUN gem install bundler -v 2.4.6

#Set an environment variable for the Rails app root folder
ENV RAILS_ROOT /var/www/go_viral

#Create the working directory
RUN mkdir -p $RAILS_ROOT

WORKDIR $RAILS_ROOT
COPY Gemfile Gemfile.lock ./

RUN bundle config build.nokogiri --use-system-libraries
RUN bundle lock --add-platform x86_64-linux x86-mingw32 x86-mswin32 x64-mingw32 java
RUN bundle check || bundle install

COPY . ./
COPY .env.example .env
COPY .git/ ./.git/

RUN npm install
RUN RAILS_ENV=production rails assets:precompile
#Permission 755 allows the execute permission for all users to run the script
RUN chmod 755 .ci/entrypoints/app-server.sh

EXPOSE 3000
ENTRYPOINT [".ci/entrypoints/app-server.sh"]
